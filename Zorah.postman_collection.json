									"if (pm.response.code === 200) {",
									"    // Parse the JSON response body",
									"    const responseJson = pm.response.json();",
									"",
									"    // Check if the 'accessToken' and 'refreshToken' properties exist in the response",
									"    if (responseJson && responseJson.accessToken && responseJson.refreshToken) {",
									"",
									"        // Set the 'accessToken' as an Environment variable",
									"        pm.environment.set(\"accessToken\", responseJson.accessToken);",
									"",
									"        // Set the 'refreshToken' as an Environment variable",
									"        pm.environment.set(\"refreshToken\", responseJson.refreshToken);",
									"",
									"        console.log(\"Tokens saved to environment!\");",
									"    } else {",
									"        console.log(\"Tokens not found in response.\");",
									"    }",
